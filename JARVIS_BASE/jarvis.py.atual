# -*- coding: utf-8 -*-

"""
J.A.R.V.I.S
PERSONAL INTELLIGENCE SYSTEM

Modo desktop:
JARVIS -> Orquestrador -> Executor -> ChatGPT via Playwright
"""

import os

from playwright.sync_api import sync_playwright

from ai.orquestrador import Orquestrador
from ai.executor import Executor


BASE_DIR = os.path.dirname(os.path.abspath(__file__))
PERFIL_CHROMIUM = os.path.join(BASE_DIR, "dados_chromium")


class Jarvis:

    def __init__(self):
        self.playwright = None
        self.browser = None
        self.page = None

        self.orquestrador = Orquestrador()
        self.executor = Executor()

    def iniciar_navegador(self):
        print("JARVIS: Iniciando navegador...")

        self.playwright = sync_playwright().start()

        self.browser = self.playwright.chromium.launch_persistent_context(
            user_data_dir=PERFIL_CHROMIUM,
            headless=False,
            viewport={
                "width": 1400,
                "height": 900
            }
        )

        if self.browser.pages:
            self.page = self.browser.pages[0]
        else:
            self.page = self.browser.new_page()

        print("JARVIS: Navegador conectado.")

    def obter_pagina(self):
        if self.page is not None:
            try:
                if not self.page.is_closed():
                    return self.page
            except Exception:
                pass

        self.iniciar_navegador()
        return self.page

    def processar_comando(self, comando):
        comando = str(comando).strip()

        if not comando:
            return

        print()
        print("Você:", comando)

        try:
            acao = self.orquestrador.interpretar(comando)

            print("JARVIS: Ação:", acao)

            pagina = self.obter_pagina()

            resposta = self.executor.executar(
                pagina,
                acao
            )

            if resposta is not None:
                print()
                print("JARVIS:", resposta)

        except Exception as erro:
            print()
            print("JARVIS: Erro:", erro)

    def fechar_navegador(self):
        print()
        print("JARVIS: Encerrando...")

        try:
            if self.browser is not None:
                self.browser.close()
        except Exception:
            pass

        try:
            if self.playwright is not None:
                self.playwright.stop()
        except Exception:
            pass

        self.browser = None
        self.page = None
        self.playwright = None


def main():

    print()
    print("=" * 60)
    print("                 J.A.R.V.I.S")
    print("          PERSONAL INTELLIGENCE SYSTEM")
    print("=" * 60)
    print()
    print("JARVIS: Sistema iniciando...")
    print()

    jarvis = Jarvis()

    try:
        jarvis.iniciar_navegador()

        print()
        print("JARVIS: ONLINE.")
        print("Digite seu comando.")
        print("Digite 'sair' para encerrar.")
        print()

        while True:

            try:
                comando = input("Você: ").strip()
            except EOFError:
                break

            if not comando:
                continue

            if comando.lower() in (
                "sair",
                "exit",
                "quit",
                "encerrar"
            ):
                break

            jarvis.processar_comando(comando)

    except KeyboardInterrupt:

        print()
        print("JARVIS: Encerramento solicitado.")

    except Exception as erro:

        print()
        print("JARVIS: Erro fatal:", erro)

    finally:

        jarvis.fechar_navegador()

        print()
        print("JARVIS offline.")


if __name__ == "__main__":
    main()
