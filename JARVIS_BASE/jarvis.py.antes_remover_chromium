            )

            continue

        if escolha == "2":

            listar_comandos(
                gerenciador
            )

            input(
                "\nPressione ENTER para continuar..."
            )

            continue

        if escolha == "3":

            editar_comando(
                gerenciador
            )

            input(
                "\nPressione ENTER para continuar..."
            )

            continue

        if escolha == "4":

            apagar_comando(
                gerenciador
            )

            input(
                "\nPressione ENTER para continuar..."
            )

            continue

        if escolha == "5":

            return

        print()
        print(
            "JARVIS: Opcao invalida."
        )

def ensinar_comando(
    gerenciador: GerenciadorHabilidades
) -> None:

    print()
    print("=" * 50)
    print(" JARVIS - CENTRO DE ENSINO")
    print("=" * 50)

    print()
    print(
        "JARVIS: Vamos ensinar uma nova habilidade."
    )

    nome = input(
        "Nome da habilidade: "
    ).strip()

    if not nome:

        print(
            "JARVIS: Nome obrigatorio."
        )

        return

    print()
    print(
        "Digite as frases que deverao ativar "
        "essa habilidade."
    )

    print(
        "Deixe vazio para terminar."
    )

    gatilhos = []

    while True:

        gatilho = input(
            "Gatilho: "
        ).strip()

        if not gatilho:

            break

        gatilhos.append(
            gatilho
        )

    if not gatilhos:

        print(
            "JARVIS: Nenhum gatilho informado."
        )

        return

    print()
    print(
        "Tipos de acao:"
    )

    print(
        "1 - abrir_programa"
    )

    print(
        "2 - abrir_site"
    )

    print(
        "3 - powershell"
    )

    print(
        "4 - esperar"
    )

    print(
        "5 - falar"
    )

    acoes = []

    while True:

        print()

        opcao = input(
            "Tipo da acao: "
        ).strip()

        mapa = {
            "1": "abrir_programa",
            "2": "abrir_site",
            "3": "powershell",
            "4": "esperar",
            "5": "falar",
        }

        tipo = mapa.get(
            opcao
        )

        if tipo is None:

            print(
                "JARVIS: Tipo invalido."
            )

            continue

        valor = input(
            f"Valor para {tipo}: "
        ).strip()

        if not valor:

            print(
                "JARVIS: Valor obrigatorio."
            )

            continue

        acoes.append(
            {
                "tipo": tipo,
                "valor": valor,
            }
        )

        adicionar = input(
            "Adicionar outra acao? [s/n]: "
        ).strip().lower()

        if adicionar != "s":

            break

    if not acoes:

        print(
            "JARVIS: Nenhuma acao criada."
        )

        return

    habilidade = gerenciador.adicionar(
        nome,
        gatilhos,
        acoes
    )

    print()
    print("=" * 50)
    print(" HABILIDADE APRENDIDA")
    print("=" * 50)

    print(
        "Nome:",
        habilidade["nome"]
    )

    print(
        "Gatilhos:",
        ", ".join(
            habilidade["gatilhos"]
        )
    )

    print(
        "Acoes:",
        len(
            habilidade["acoes"]
        )
    )

    print()
    print(
        "JARVIS: Pronto. Aprendi essa habilidade."
    )

# ================================================================
# PROCESSAMENTO DO COMANDO
# ================================================================

def processar_comando(
    comando: str,
    orquestrador: Orquestrador,
    executor: Executor,
    nav: NavegadorManager,
    gerenciador_habilidades: GerenciadorHabilidades,
    executor_habilidades: ExecutorHabilidades,
) -> None:

    habilidade = gerenciador_habilidades.encontrar(
        comando
    )

    if habilidade is not None:

        print()
        print(
            "JARVIS: Habilidade aprendida encontrada."
        )

        resultado = executor_habilidades.executar(
            habilidade
        )

        print()
        print(
            "JARVIS:",
            resultado
        )

        return

    pagina = nav.garantir_pagina()

    acao = orquestrador.interpretar(
        comando
    )

    print(
        "AA‡AƒO:",
        acao
    )

    tipo_acao = acao.get(
        "acao"
    )

    if tipo_acao == "desconhecida":

        resultado = (
            "Ainda nao sei executar "
            "esse comando."
        )

    else:

        resultado = executor.executar(
            pagina,
            acao
        )

    if (
        isinstance(resultado, dict)
        and tipo_acao == "ler"
    ):

        mostrar_pagina(
            resultado
        )

        return

    print()
    print(
        "JARVIS:",
        resultado
    )


# ================================================================
# LOOP PRINCIPAL
# ================================================================

def main() -> None:

    orquestrador = Orquestrador()

    executor = Executor()

    gerenciador_habilidades = (
        GerenciadorHabilidades()
    )

    executor_habilidades = (
        ExecutorHabilidades()
    )

    print("=" * 50)
    print(" J.A.R.V.I.S - NUCLEO OPERACIONAL")
    print("=" * 50)
    print("Voz e texto ativados.")
    print()

    erros_seguidos = 0

    with sync_playwright() as p:

        nav = NavegadorManager(
            p,
            headless=False
        )

        try:

            while True:

                try:

                    comando = obter_comando()

                except KeyboardInterrupt:

                    print(
                        "\nJARVIS: Interrompido "
                        "pelo usuario. Encerrando."
                    )

                    break

                if not comando:

                    print(
                        "JARVIS: Nao entendi."
                    )

                    continue

                if comando == "__ENSINAR_COMANDO__":

                    gerenciar_comandos(
                        gerenciador_habilidades
                    )

                    continue

                if comando.lower() in COMANDOS_SAIDA:

                    print(
                        "JARVIS: Encerrando."
                    )

                    break

                print(
                    f"JARVIS recebeu: {comando}"
                )

                try:

                    processar_comando(
                        comando,
                        orquestrador,
                        executor,
                        nav,
                        gerenciador_habilidades,
                        executor_habilidades,
                    )

                    erros_seguidos = 0

                except Exception as erro:

                    erros_seguidos += 1

                    print()
                    print(
                        "JARVIS: Erro durante "
                        "a execucao."
                    )

                    print(
                        f"ERRO: {erro}"
                    )

                    traceback.print_exc()

                    if erros_seguidos >= MAX_ERROS_SEGUIDOS:

                        print(
                            f"JARVIS: {MAX_ERROS_SEGUIDOS} "
                            "erros seguidos a€” algo esta "
                            "sistematicamente errado."
                        )

                        print(
                            "JARVIS: Encerrando para "
                            "evitar loop infinito."
                        )

                        break

                    try:

                        nav.garantir_pagina()

                        print(
                            "JARVIS: Navegador "
                            "verificado/reconstruido."
                        )

                    except Exception as erro2:

                        print(
                            "JARVIS: Nao consegui "
                            "reconstruir o navegador."
                        )

                        print(
                            f"ERRO: {erro2}"
                        )

                print()

        finally:

            nav.fechar()


# ================================================================
# ENTRY POINT
# ================================================================

if __name__ == "__main__":

    main()












