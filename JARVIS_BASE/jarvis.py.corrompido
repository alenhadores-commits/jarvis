# ============================================================

# ENTRADA

# ============================================================

def obter_comando():

```
escolha = input(
    "Escolha: "
).strip()

if escolha == "1":

    print()
    print(
        "JARVIS: Modo voz ainda será conectado."
    )

    return None

if escolha == "2":

    comando = input(
        "\nVocê: "
    ).strip()

    return comando

if escolha == "3":

    mostrar_memorias()

    return None

if escolha == "4":

    mostrar_prompt()

    return None

if escolha == "5":

    return "__SAIR__"

print()
print(
    "JARVIS: Opção inválida."
)

return None
```

# ============================================================

# MAIN

# ============================================================

def main():

```
print(
    "J.A.R.V.I.S inicializando..."
)

print(
    "Sistema online."
)

jarvis = Jarvis()

try:

    while True:

        menu()

        comando = obter_comando()

        if comando == "__SAIR__":

            break

        if not comando:

            continue

        jarvis.processar_comando(
            comando
        )

except KeyboardInterrupt:

    print()
    print(
        "JARVIS: Encerramento solicitado."
    )

finally:

    jarvis.fechar_navegador()

    print()
    print(
        "JARVIS offline."
    )
```

# ============================================================

# EXECUÇÃO

# ============================================================

if **name** == "**main**":

```
main()
