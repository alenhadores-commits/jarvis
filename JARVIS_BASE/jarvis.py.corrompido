# -*- coding: utf-8 -*-

"""
J.A.R.V.I.S
PERSONAL INTELLIGENCE SYSTEM

Modo desktop:
JARVIS -> Orquestrador -> Executor -> ChatGPT via Playwright
"""

import json
import os
import time

from playwright.sync_api import sync_playwright

from ai.orquestrador import Orquestrador
from ai.executor import Executor

# ============================================================

# CONFIGURAÇÃO

# ============================================================

BASE_DIR = os.path.dirname(
os.path.abspath(__file__)
)

PERFIL_CHROMIUM = os.path.join(
BASE_DIR,
"dados_chromium"
)

# ============================================================

# JARVIS

# ============================================================

class Jarvis:

```
def __init__(self):

    self.playwright = None
    self.browser = None
    self.page = None

    self.orquestrador = Orquestrador()
    self.executor = Executor()


# ========================================================
# NAVEGADOR
# ========================================================

def iniciar_navegador(self):

    print()
    print("JARVIS: Inicializando navegador...")

    self.playwright = sync_playwright().start()

    try:

        self.browser = (
            self.playwright
            .chromium
            .launch_persistent_context(
                user_data_dir=PERFIL_CHROMIUM,
                headless=False,
                viewport={
                    "width": 1400,
                    "height": 900
                }
            )
        )

        if self.browser.pages:

            self.page = self.browser.pages[0]

        else:

            self.page = self.browser.new_page()

        print("JARVIS: Navegador conectado.")

        return self.page

    except Exception:

        self.fechar_navegador()

        raise


# ========================================================
# GARANTIR PÁGINA
# ========================================================

def obter_pagina(self):

    if self.page is not None:

        try:

            if not self.page.is_closed():

                return self.page

        except Exception:
            pass

    return self.iniciar_navegador()


# ========================================================
# PROCESSAR COMANDO
# ========================================================

def processar_comando(self, comando):

    comando = str(
        comando or ""
    ).strip()

    if not comando:

        return None

    print()
    print(
        f"JARVIS recebeu: {comando}"
    )
    print()

    try:

        page = self.obter_pagina()

        # ------------------------------------------------
        # ORQUESTRADOR
        # ------------------------------------------------

        acao = (
            self.orquestrador
            .interpretar(comando)
        )

        print(
            f"JARVIS: Ação identificada: "
            f"{acao.get('acao')}"
        )

        # ------------------------------------------------
        # EXECUTOR
        # ------------------------------------------------

        resultado = (
            self.executor
            .executar(
                page,
                acao
            )
        )

        if isinstance(
            resultado,
            dict
        ):

            resposta = (
                resultado.get("resposta")
                or resultado.get("resultado")
                or resultado.get("texto")
                or str(resultado)
            )

        else:

            resposta = str(
                resultado or ""
            )

        if resposta.strip():

            print()
            print(
                f"JARVIS: {resposta}"
            )

            return resposta

        print()
        print(
            "JARVIS: Nenhuma resposta retornada."
        )

        return None

    except Exception as erro:

        print()
        print(
            f"JARVIS: Erro: {erro}"
        )

        return None


# ========================================================
# FECHAR
# ========================================================

def fechar_navegador(self):

    print()
    print("JARVIS: Encerrando navegador...")

    try:

        if self.browser is not None:

            self.browser.close()

    except Exception:
        pass

    self.browser = None
    self.page = None

    try:

        if self.playwright is not None:

            self.playwright.stop()

    except Exception:
        pass

    self.playwright = None

    print(
        "JARVIS: Navegador encerrado."
    )
```

# ============================================================

# PROMPT

# ============================================================

PROMPT_PADRAO = """
Você é J.A.R.V.I.S., assistente pessoal inteligente.

Responda em português brasileiro.

Seja inteligente, direto, confiante, sarcástico e bem-humorado.
Use naturalmente algumas expressões nordestinas, sem exagerar.

Seja objetivo.
Resolva primeiro, zoe depois.

Quando houver contexto ou memória relevante, use-o.
"""

def carregar_prompt():

```
caminhos = [

    os.path.join(
        BASE_DIR,
        "PROMPT_JARVIS.txt"
    ),

    os.path.join(
        BASE_DIR,
        "prompt_jarvis.json"
    )
]

for caminho in caminhos:

    if not os.path.exists(caminho):
        continue

    try:

        if caminho.endswith(".json"):

            with open(
                caminho,
                "r",
                encoding="utf-8"
            ) as arquivo:

                dados = json.load(arquivo)

            if isinstance(
                dados,
                dict
            ):

                return (
                    dados.get("prompt")
                    or dados.get("personalidade")
                    or str(dados)
                )

        else:

            with open(
                caminho,
                "r",
                encoding="utf-8"
            ) as arquivo:

                texto = arquivo.read().strip()

                if texto:

                    return texto

    except Exception:
        continue

return PROMPT_PADRAO
```

# ============================================================

# MEMÓRIAS

# ============================================================

def mostrar_memorias():

```
print()
print("=" * 60)
print("MEMÓRIAS PERMANENTES")
print("=" * 60)

arquivos = [

    os.path.join(
        BASE_DIR,
        "memorias.json"
    ),

    os.path.join(
        BASE_DIR,
        "memoria.json"
    )
]

encontrou = False

for caminho in arquivos:

    if not os.path.exists(caminho):
        continue

    try:

        with open(
            caminho,
            "r",
            encoding="utf-8"
        ) as arquivo:

            dados = json.load(arquivo)

        print(
            json.dumps(
                dados,
                ensure_ascii=False,
                indent=2
            )
        )

        encontrou = True

    except Exception as erro:

        print(
            f"Erro lendo {caminho}: {erro}"
        )

if not encontrou:

    print(
        "Nenhum arquivo local de memória encontrado."
    )

print()
```

# ============================================================

# PROMPT

# ============================================================

def mostrar_prompt():

```
print()
print("=" * 60)
print("PROMPT DO JARVIS")
print("=" * 60)
print()

print(
    carregar_prompt()
)

print()
```

